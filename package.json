{
  "name": "pickforus",
  "version": "3.0.0",
  "license": "MIT",
  "type": "module",
  "description": "60-second anonymous group chat that breaks friend-group indecision using local LLM extraction and deterministic negation/spam rules.",
  "repository": {
    "type": "git",
    "url": "https://github.com/cnsaavedra/pickforus.git"
  },
  "keywords": [
    "llm",
    "ollama",
    "neuro-symbolic",
    "group-decision",
    "websocket",
    "typescript",
    "react"
  ],
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --no-warnings dist/server/index.js --prod",
    "test": "vitest run",
    "check": "biome check . && tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  }
}
